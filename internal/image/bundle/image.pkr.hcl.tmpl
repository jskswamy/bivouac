# A self-contained Packer template for one Bivouac image, generated by
# Bivouac [[ .BivouacVersion ]]. It needs only Packer: see README.md.

packer {
  required_plugins {
[[ if eq .Provider "gcloud" ]]
    googlecompute = {
      source  = "github.com/hashicorp/googlecompute"
      version = ">= 1.1.0"
    }
[[ else ]]
    digitalocean = {
      source  = "github.com/hashicorp/digitalocean"
      version = "= [[ .PluginVersion ]]"
    }
[[ end ]]
  }
}

[[ if eq .Provider "gcloud" ]]
variable "project_id" {
  type    = string
  default = "[[ .Project ]]"
}

variable "zone" {
  type    = string
  default = "[[ .Zone ]]"
}

variable "machine_type" {
  type    = string
  default = "[[ .Size ]]"
}

variable "username" {
  type    = string
  default = "[[ .Username ]]"
}

source "googlecompute" "image" {
  project_id   = var.project_id
  zone         = var.zone
  machine_type = var.machine_type
  source_image = "[[ .SourceImage ]]"
  ssh_username = "root"
  metadata = {
    user-data = file("scripts/bootstrap.sh")
  }
  image_name   = "bivouac-[[ .Tag ]]-${formatdate("YYYYMMDD-hhmmss", timestamp())}"
  image_labels = {
    bivouac-image   = "true"
    bivouac-format  = "1"
    bivouac-arch    = "[[ .Arch ]]"
    bivouac-region  = var.zone
    bivouac-shell   = "[[ .Shell ]]"
    bivouac-tag     = "[[ .Tag ]]"
  }
}
[[ else ]]
# Read from the environment at run time and never written to this
# directory, so the bundle stays safe to commit.
variable "do_token" {
  type      = string
  default   = env("DIGITALOCEAN_TOKEN")
  sensitive = true
}

variable "region" {
  type    = string
  default = "[[ .Region ]]"
}

variable "size" {
  type    = string
  default = "[[ .Size ]]"
}

# The account a launch will log in as. The closure is built under this
# name because Home Manager reads it into the activation package.
variable "username" {
  type    = string
  default = "[[ .Username ]]"
}

# Every build starts from stock Ubuntu, never from a previous image. The
# region marker follows var.region, so an override is tagged where the
# snapshot actually lives.
source "digitalocean" "image" {
  api_token      = var.do_token
  image          = "[[ .SourceImage ]]"
  region         = var.region
  size           = var.size
  ssh_username   = "root"
  user_data_file = "scripts/bootstrap.sh"
  snapshot_name  = "[[ .Tag ]]-${formatdate("YYYYMMDD-hhmmss", timestamp())}"
  snapshot_tags  = [[ .SnapshotTags ]]
}
[[ end ]]

build {
[[ if eq .Provider "gcloud" ]]
  sources = ["source.googlecompute.image"]
[[ else ]]
  sources = ["source.digitalocean.image"]
[[ end ]]

  # SSH being up says nothing about user data having finished.
  provisioner "shell" {
    script          = "scripts/wait-bootstrap.sh"
    execute_command = "chmod +x {{ .Path }}; {{ .Vars }} {{ .Path }} [[ .Shell ]]"
  }

  provisioner "shell" {
    inline = ["mkdir -p /var/lib/bivouac-image"]
  }
[[ if .Rendered ]]
  provisioner "file" {
    source      = "nix"
    destination = "/var/lib/bivouac-image"
  }
[[ end ]]
  # The variables as run, not the generated defaults, so an image built
  # with -var region=... does not record the region it was not built in.
  provisioner "file" {
    content     = jsonencode(merge(jsondecode(file("${path.root}/metadata.json")), { region = [[ if eq .Provider "gcloud" ]]var.zone[[ else ]]var.region[[ end ]], size = [[ if eq .Provider "gcloud" ]]var.machine_type[[ else ]]var.size[[ end ]], username = var.username }))
    destination = "/var/lib/bivouac-image/metadata.json"
  }

  provisioner "shell" {
    script          = "scripts/build-closure.sh"
    execute_command = "chmod +x {{ .Path }}; {{ .Vars }} {{ .Path }} ${var.username}"
  }

  provisioner "shell" {
    script          = "scripts/sanitize.sh"
    execute_command = "chmod +x {{ .Path }}; {{ .Vars }} {{ .Path }} ${var.username}"
  }

  # The artifact ID comes from here, not from Packer's log output.
  post-processor "manifest" {
    output     = "packer-manifest.json"
    strip_path = true
  }
}
